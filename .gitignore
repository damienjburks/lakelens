# Terraform working directories, state, plans, and local configuration
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Keep .terraform.lock.hcl tracked for reproducible provider versions.

# Python environments, bytecode, test caches, and coverage
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/

# Generated packages and build artifacts
build/
dist/
*.zip

# Credentials and local secrets
.env
.env.*
!.env.example
!.env.sample
.aws/
*.pem
*.key

# Local editor / assistant files and OS metadata
.idea/
.vscode/
.kiro/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
